// Modelo de datos genérico para tienda online (celulares, laptops, autos, ropa, juguetes, etc.)
// Todos los montos se guardan en CÉNTIMOS (Int) para evitar errores de redondeo. S/ 1,299.90 => 129990

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── Usuarios del panel ─────────────────────────

enum Role {
  ADMIN
  STAFF
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(ADMIN)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ───────────────────────── Catálogo ─────────────────────────

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  image       String?
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryTree")
  sortOrder   Int        @default(0)
  active      Boolean    @default(true)
  products    Product[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Brand {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  logo      String?
  products  Product[]
  createdAt DateTime  @default(now())
}

enum ProductCondition {
  NEW // Nuevo
  USED // Usado / seminuevo
  REFURBISHED // Reacondicionado
}

model Product {
  id             String           @id @default(cuid())
  name           String
  slug           String           @unique
  description    String           @default("")
  sku            String?          @unique
  categoryId     String
  category       Category         @relation(fields: [categoryId], references: [id])
  brandId        String?
  brand          Brand?           @relation(fields: [brandId], references: [id], onDelete: SetNull)
  /// Precio en céntimos. Si el producto tiene variantes, es el precio "desde".
  price          Int
  /// Precio anterior tachado (en céntimos), opcional.
  compareAtPrice Int?
  /// Stock cuando el producto NO tiene variantes.
  stock          Int              @default(0)
  images         String[]
  /// Ficha técnica libre: { "Pantalla": "6.1\"", "RAM": "8 GB" } o { "Año": "2020", "Kilometraje": "45000 km" }
  specs          Json             @default("{}")
  condition      ProductCondition @default(NEW)
  featured       Boolean          @default(false)
  active         Boolean          @default(true)
  variants       ProductVariant[]
  orderItems     OrderItem[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([categoryId])
  @@index([brandId])
  @@index([active, featured])
}

/// Variante vendible: color/capacidad (celulares), talla/color (ropa), versión (autos)...
model ProductVariant {
  id         String      @id @default(cuid())
  productId  String
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Ej: "Negro / 256 GB"
  name       String
  sku        String?     @unique
  /// Opciones: { "Color": "Negro", "Almacenamiento": "256 GB" }
  options    Json        @default("{}")
  /// Precio en céntimos; si es null usa el precio del producto.
  price      Int?
  stock      Int         @default(0)
  image      String?
  active     Boolean     @default(true)
  sortOrder  Int         @default(0)
  orderItems OrderItem[]

  @@index([productId])
}

// ───────────────────────── Pedidos y pagos ─────────────────────────

enum OrderStatus {
  PENDING // Creado, esperando pago
  PAID // Pago confirmado
  PROCESSING // Preparando
  SHIPPED // Enviado
  DELIVERED // Entregado
  CANCELLED // Cancelado (stock devuelto)
}

enum PaymentStatus {
  PENDING // Aún no paga
  AWAITING_VERIFICATION // Cliente reportó pago manual (Yape/Plin/transferencia)
  APPROVED
  REJECTED
  REFUNDED
}

enum PaymentMethod {
  MERCADOPAGO // Tarjetas, Yape, PagoEfectivo y más vía Mercado Pago
  YAPE // Yape directo (QR / número) con validación manual
  PLIN // Plin directo con validación manual
  BANK_TRANSFER // Transferencia / depósito bancario
  CASH_ON_DELIVERY // Pago contra entrega
}

enum DeliveryMethod {
  SHIPPING // Envío a domicilio
  PICKUP // Recojo en tienda
}

enum DocumentType {
  DNI
  CE
  RUC
  PASAPORTE
}

model Order {
  id             String         @id @default(cuid())
  /// Número correlativo visible para el cliente (#1, #2...)
  number         Int            @unique @default(autoincrement())
  status         OrderStatus    @default(PENDING)
  paymentMethod  PaymentMethod
  paymentStatus  PaymentStatus  @default(PENDING)
  deliveryMethod DeliveryMethod @default(SHIPPING)

  // Cliente
  customerName   String
  customerEmail  String
  customerPhone  String
  documentType   DocumentType @default(DNI)
  documentNumber String
  /// Razón social (si documentType = RUC, para factura)
  businessName   String?

  // Envío
  department String?
  province   String?
  district   String?
  address    String?
  reference  String?

  subtotal     Int
  shippingCost Int     @default(0)
  total        Int
  notes        String?
  /// Nota interna del admin (tracking, etc.)
  adminNotes   String?

  items     OrderItem[]
  payments  Payment[]
  paidAt    DateTime?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([status])
  @@index([customerEmail])
  @@index([createdAt])
}

model OrderItem {
  id          String          @id @default(cuid())
  orderId     String
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId   String?
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  // Copia de los datos al momento de la compra (por si luego cambian)
  name        String
  variantName String?
  sku         String?
  image       String?
  unitPrice   Int
  quantity    Int
  total       Int

  @@index([orderId])
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method            PaymentMethod
  status            PaymentStatus @default(PENDING)
  amount            Int
  /// ID del pago en la pasarela (Mercado Pago payment id)
  providerPaymentId String?       @unique
  /// Medio usado dentro de la pasarela: visa, master, yape, pagoefectivo_atm...
  providerMethod    String?
  /// Nº de operación reportado por el cliente (Yape/Plin/transferencia)
  operationNumber   String?
  /// Captura del voucher subida por el cliente
  receiptImage      String?
  /// Respuesta cruda de la pasarela, para auditoría
  raw               Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([orderId])
}

// ───────────────────────── Libro de Reclamaciones (obligatorio INDECOPI) ─────────────────────────

enum ComplaintType {
  RECLAMO // Disconformidad con el producto o servicio
  QUEJA // Malestar por la atención
}

enum ComplaintStatus {
  OPEN
  ANSWERED
}

model Complaint {
  id              String          @id @default(cuid())
  /// Correlativo de la hoja de reclamación
  number          Int             @unique @default(autoincrement())
  type            ComplaintType
  status          ComplaintStatus @default(OPEN)
  customerName    String
  documentType    DocumentType
  documentNumber  String
  address         String
  phone           String
  email           String
  /// Padre/madre o apoderado si el consumidor es menor de edad
  guardianName    String?
  /// PRODUCTO o SERVICIO
  itemType        String
  itemDescription String
  amount          Int?
  orderNumber     Int?
  detail          String
  request         String
  response        String?
  respondedAt     DateTime?
  createdAt       DateTime        @default(now())
}

// ───────────────────────── Configuración de la tienda ─────────────────────────

enum MercadoPagoMode {
  EMBEDDED
  REDIRECT
}

/// Fila única (id = "default") editable desde el panel.
model StoreSettings {
  id           String  @id @default("default")
  storeName    String  @default("Mi Tienda")
  tagline      String  @default("Tu tienda online en Perú")
  /// Razón social y RUC (obligatorios en el Libro de Reclamaciones)
  legalName    String?
  ruc          String?
  logo         String?
  contactEmail String?
  contactPhone String?
  /// Número de WhatsApp con código de país, sin +. Ej: 51987654321
  whatsapp     String?
  address      String?

  // Envíos (céntimos)
  shippingFlatRate Int     @default(1500)
  /// Envío gratis desde este subtotal (céntimos). null = nunca
  freeShippingFrom Int?
  pickupEnabled    Boolean @default(true)
  pickupAddress    String?

  // Medios de pago habilitados
  mercadoPagoEnabled    Boolean         @default(true)
  /// EMBEDDED = formulario de tarjeta/Yape dentro de la tienda (Bricks) · REDIRECT = Checkout Pro
  mercadoPagoMode       MercadoPagoMode @default(EMBEDDED)
  yapeEnabled           Boolean         @default(true)
  yapePhone             String?
  yapeHolder            String?
  yapeQr                String?
  plinEnabled           Boolean         @default(false)
  plinPhone             String?
  plinHolder            String?
  plinQr                String?
  bankTransferEnabled   Boolean         @default(true)
  /// Texto libre: "BCP Soles 191-XXXXXXX-0-XX / CCI 002-191-..."
  bankAccounts          String?
  cashOnDeliveryEnabled Boolean         @default(false)

  updatedAt DateTime @updatedAt
}

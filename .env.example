# ─── Base de datos (PostgreSQL) ───
# Formato: postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/BASE?schema=public
DATABASE_URL="postgresql://postgres:TU_PASSWORD@localhost:5432/tienda?schema=public"

# ─── App ───
# URL pública de la tienda (en producción: https://tudominio.pe)
APP_URL="http://localhost:3000"
# Secreto para firmar las sesiones del panel (mín. 32 caracteres). Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""
# Carpeta donde se guardan las imágenes subidas
UPLOAD_DIR="uploads"

# ─── Mercado Pago (https://www.mercadopago.com.pe/developers/panel/app) ───
# Credenciales de PRUEBA (TEST-...) para desarrollo y de PRODUCCIÓN (APP_USR-...) para vender de verdad.
# Access Token: secreto, solo en el servidor. Public Key: la usa el navegador para el formulario de tarjeta y Yape.
MP_ACCESS_TOKEN=""
MP_PUBLIC_KEY=""
# Clave secreta del webhook (Tus integraciones > Webhooks > Clave secreta)
MP_WEBHOOK_SECRET=""

# ─── Usuario administrador inicial (lo crea `npm run db:seed`) ───
ADMIN_EMAIL="admin@tienda.pe"
ADMIN_PASSWORD="cambia-esta-clave"
ADMIN_NAME="Administrador"
